# Where this app's Supabase project lives — existing (Cloud or self-hosted)
# or the one created by docker/docker-compose.yml. See README.md.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only — never exposed to the browser. Used by the admin API route
# handlers (app/api/**) to perform privileged operations that bypass RLS,
# e.g. reading membership lists across an organization.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_URL=http://localhost:8000
