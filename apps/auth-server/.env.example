# Where this app's Supabase project lives — existing (Cloud or self-hosted)
# or the one created by docker/docker-compose.yml. See README.md.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only — never exposed to the browser. Used by the admin API route
# handlers (app/api/**) to perform privileged operations that bypass RLS,
# e.g. reading membership lists across an organization.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_URL=http://localhost:8000

# Only needed when auth-server and admin-panel are deployed on different
# subdomains of the same domain (e.g. "auth.example.com" and
# "admin.example.com") — set to ".example.com" so the session cookie set
# here is readable by admin-panel too. Leave unset if they share a host
# (including localhost, where the browser already shares cookies across
# ports).
NEXT_PUBLIC_COOKIE_DOMAIN=

# Only flips the "Continuar con Google" button on — the actual client_id/
# secret are configured on the Supabase project itself (self-hosted:
# GOTRUE_EXTERNAL_GOOGLE_* env vars / config.toml; Cloud: Dashboard), never
# here. Leave unset (or "false") on installs that haven't enabled Google.
NEXT_PUBLIC_GOOGLE_LOGIN_ENABLED=false

# Same idea as above, for the "Continuar con Microsoft" button — Azure AD
# (Entra ID) client_id/secret live on the Supabase project's GOTRUE_EXTERNAL_AZURE_*
# config, never here.
NEXT_PUBLIC_MICROSOFT_LOGIN_ENABLED=false
