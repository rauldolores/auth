# Where this app's Supabase project lives — existing (Cloud or self-hosted)
# or the one created by docker/docker-compose.yml. See README.md.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Server-only — never exposed to the browser. Used by the admin API route
# handlers (app/api/**) to perform privileged operations that bypass RLS,
# e.g. reading membership lists across an organization.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key
SUPABASE_URL=http://localhost:8000

# Optional, and only relevant on a Supabase-Cloud-backed deployment. Lets
# admin-panel's "Inicio de sesión social" screen activate Google/Microsoft
# login live, without ever visiting the Supabase dashboard. Two ways to set
# this up — the OAuth pair below is preferred (self-renewing, never
# expires); SUPABASE_MANAGEMENT_API_TOKEN is a simpler fallback that does
# expire on whatever schedule you pick when generating it. Either way,
# leaving both unset is fine on self-hosted Docker installs (no equivalent
# API exists there) — the login buttons and the admin-panel screen's status
# keep working correctly regardless, just without the in-app write path.
#
# Preferred: register a "Supabase OAuth App" once, from your organization's
# Settings → OAuth Apps (https://supabase.com/dashboard/org/_/apps) — name
# it anything, redirect URI is <NEXT_PUBLIC_ADMIN_PANEL_URL>/oauth/supabase-callback.
# Paste the resulting client_id/client_secret below, then click "Conectar
# con Supabase" from the Inicio de sesión social screen — a platform admin
# authorizes it once, and access renews itself forever after that.
SUPABASE_OAUTH_CLIENT_ID=
SUPABASE_OAUTH_CLIENT_SECRET=

# Fallback: a Supabase Management API personal access token — generate one
# at https://supabase.com/dashboard/account/tokens. Only used when the
# OAuth pair above isn't connected. IMPORTANT: unlike SUPABASE_SERVICE_ROLE_KEY
# (scoped to this one project), both this token and the OAuth pair above can
# manage your ENTIRE Supabase account — every project, billing included.
# Treat them accordingly.
SUPABASE_MANAGEMENT_API_TOKEN=

# Only needed when auth-server and admin-panel are deployed on different
# subdomains of the same domain (e.g. "auth.example.com" and
# "admin.example.com") — set to ".example.com" so the session cookie set
# here is readable by admin-panel too. Leave unset if they share a host
# (including localhost, where the browser already shares cookies across
# ports).
NEXT_PUBLIC_COOKIE_DOMAIN=

# Where admin-panel is hosted. Used only to validate the "redirect_to" query
# param on /login and /mfa-challenge — after signing in, someone who arrived
# from admin-panel is sent back there instead of to this app's own home
# page. A redirect_to pointing anywhere else is ignored (open-redirect
# protection), so this must match admin-panel's real URL exactly.
NEXT_PUBLIC_ADMIN_PANEL_URL=http://localhost:3001
