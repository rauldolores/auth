NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key

# Where auth-server is hosted — used to send unauthenticated visitors to its
# /login page. Required if admin-panel is deployed on its own domain.
NEXT_PUBLIC_AUTH_SERVER_URL=http://localhost:3000

# Only needed when auth-server and admin-panel are deployed on different
# subdomains of the same domain (e.g. "auth.example.com" and
# "admin.example.com") — set to ".example.com" so the session cookie set by
# one is readable by the other. Leave unset if they share a host (including
# localhost, where the browser already shares cookies across ports).
NEXT_PUBLIC_COOKIE_DOMAIN=

# Only needed when auth-server and admin-panel are on genuinely different
# domains (not just subdomains — NEXT_PUBLIC_COOKIE_DOMAIN can't help there,
# since cookies can never cross top-level domains). admin-panel then
# establishes its own session via OAuth 2.1 instead of a shared cookie — this
# is the client_id GoTrue's OAuth server issued when admin-panel was
# registered as a client (packages/cli does this automatically during
# install/deploy; see /oauth/callback and dashboard-shell.tsx). Leave unset
# if admin-panel shares a domain/subdomain with auth-server.
NEXT_PUBLIC_OAUTH_CLIENT_ID=

# Where apps/documentation is hosted — shows an "Ayuda" menu in the sidebar
# linking out to it. Leave unset (the default) if you haven't deployed the
# docs site; the menu simply doesn't render rather than pointing at a dead
# link.
NEXT_PUBLIC_DOCS_URL=
