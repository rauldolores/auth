# Copy to docker/.env before `docker compose -f docker/docker-compose.yml up -d`.
# Generate JWT_SECRET / ANON_KEY / SERVICE_ROLE_KEY with the Supabase
# self-hosting key generator — never ship the placeholder values below.

POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

JWT_SECRET=change-me-to-a-long-random-string
ANON_KEY=replace-with-generated-anon-jwt
SERVICE_ROLE_KEY=replace-with-generated-service-role-jwt

SUPABASE_PORT=8000
SUPABASE_PUBLIC_URL=http://localhost:8000
SITE_URL=http://localhost:3000

# admin-panel's own URL — auth-server uses it to validate redirect_to and to
# know which OAuth consent requests are first-party (admin-panel itself) vs.
# a real third-party app that needs a manual approve/deny screen.
ADMIN_PANEL_URL=http://localhost:3001

# Only set this if you've put auth-server and admin-panel on different
# subdomains of one domain (e.g. auth.example.com / admin.example.com)
# instead of the default ports above — value like ".example.com". Leave
# blank for the default same-host setup; the OAuth flow (GOTRUE_OAUTH_SERVER_*
# below) handles SSO for genuinely different domains, where a shared cookie
# domain isn't possible at all.
COOKIE_DOMAIN=

# Filled in automatically by `create-kontrolia-auth` after it registers
# admin-panel as an OAuth client of this Supabase project. Leave blank on a
# fresh docker-compose.yml you're editing by hand — admin-panel falls back
# to a plain login redirect (still works, just needs a shared cookie domain
# to carry the session back).
OAUTH_CLIENT_ID=

GOTRUE_MAILER_AUTOCONFIRM=true

# Optional — per-installation, from your own Google Cloud OAuth client.
# Authorized redirect URI to register there: ${SUPABASE_PUBLIC_URL}/auth/v1/callback
GOOGLE_LOGIN_ENABLED=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
