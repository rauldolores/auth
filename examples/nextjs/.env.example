# Point this at your KontrolIA Auth installation's Supabase project — the
# same one apps/auth-server uses. This app never talks to Supabase directly
# beyond these two public values, passed straight into <AuthProvider>.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:8000
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
