  "license": "MIT",
  "description": "NestJS resource server example: a KontroliaAuthGuard built on @kontrolia/auth/server, protecting a controller route by permission.",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/main.ts",
