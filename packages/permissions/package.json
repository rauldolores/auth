{
  "name": "@kontrolia/permissions",
  "version": "1.0.1",
  "license": "MIT",
  "description": "Framework-agnostic RBAC evaluation engine (hasPermission/hasRole with hierarchical wildcard matching), shared by the SDKs, auth-server and admin-panel.",
  "keywords": [
    "kontrolia",
    "rbac",
    "permissions",
    "authorization",
    "access-control"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rauldolores/auth.git",
    "directory": "packages/permissions"
  },
  "homepage": "https://github.com/rauldolores/auth#readme",
  "bugs": "https://github.com/rauldolores/auth/issues",
  "author": "KontrolIA",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kontrolia/shared": "workspace:*"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
