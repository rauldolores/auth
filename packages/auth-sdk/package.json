{
  "name": "@kontrolia/auth",
  "version": "2.0.0",
  "license": "MIT",
  "description": "Official framework-agnostic KontrolIA Auth SDK. The only supported way to integrate an application — no app should ever import supabase-js, handle OAuth redirects, or parse a JWT directly.",
  "keywords": [
    "kontrolia",
    "auth",
    "authentication",
    "authorization",
    "supabase",
    "iam",
    "rbac",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rauldolores/auth.git",
    "directory": "packages/auth-sdk"
  },
  "homepage": "https://github.com/rauldolores/auth#readme",
  "bugs": "https://github.com/rauldolores/auth/issues",
  "author": "KontrolIA",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kontrolia/permissions": "workspace:*",
    "@kontrolia/shared": "workspace:*",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.47.10",
    "jose": "^5.9.6"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
