{
  "name": "@kontrolia/shared",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Shared TypeScript types and utilities used across every KontrolIA Auth package and app.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
