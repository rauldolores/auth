    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "eslint": "^9.17.0",
    "typescript": "^5.7.2"
  }
}
