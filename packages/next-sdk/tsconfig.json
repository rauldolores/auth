{
  "extends": "@kontrolia/config/tsconfig/nextjs.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    // This is a library package (unlike the Next.js apps that also extend
    // the "nextjs" preset), so unlike them it needs .d.ts output — other
    // packages import its types.
    "declaration": true,
    "declarationMap": true
  },
  "include": ["src"],
  "exclude": ["src/__tests__"]
}
