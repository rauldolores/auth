{
  "name": "@kontrolia/next",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Next.js integration for KontrolIA Auth: reusable route-protection middleware with automatic session refresh, and verifyRequest() for API routes acting as a resource server.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "peerDependencies": {
    "next": ">=14.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kontrolia/auth": "workspace:*",
    "@supabase/ssr": "^0.5.2"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "eslint": "^9.17.0",
    "next": "^15.1.3",
    "typescript": "^5.7.2"
