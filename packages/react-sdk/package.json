{
  "name": "@kontrolia/react",
  "version": "1.3.0",
  "license": "MIT",
  "description": "React bindings for KontrolIA Auth: <AuthProvider>, <AuthGuard>, <GuestGuard>, <RequireRole>, <RequirePermission> and useAuth().",
  "keywords": [
    "kontrolia",
    "auth",
    "react",
    "authentication",
    "authorization",
    "rbac",
    "sdk"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/rauldolores/auth.git",
    "directory": "packages/react-sdk"
  },
  "homepage": "https://github.com/rauldolores/auth#readme",
  "bugs": "https://github.com/rauldolores/auth/issues",
  "author": "KontrolIA",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kontrolia/auth": "workspace:*",
    "@kontrolia/permissions": "workspace:*",
    "@kontrolia/shared": "workspace:*"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
