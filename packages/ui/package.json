{
  "name": "@kontrolia/ui",
  "version": "1.0.0",
  "license": "MIT",
  "description": "Shared UI components (shadcn/ui + Tailwind): login/forgot/reset password forms, org switcher, user menu, 401/403/session-expired screens.",
  "keywords": ["kontrolia", "auth", "ui", "react", "components", "tailwind"],
  "repository": { "type": "git", "url": "https://github.com/rauldolores/auth.git", "directory": "packages/ui" },
  "homepage": "https://github.com/rauldolores/auth#readme",
  "bugs": "https://github.com/rauldolores/auth/issues",
  "author": "KontrolIA",
  "publishConfig": { "access": "public" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": ["dist"],
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@kontrolia/react": "workspace:*",
    "@kontrolia/shared": "workspace:*",
    "clsx": "^2.1.1"
  },
  "devDependencies": {
    "@kontrolia/config": "workspace:*",
    "@types/react": "^18.3.17",
    "@types/react-dom": "^18.3.5",
    "eslint": "^9.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.7.2"
  }
